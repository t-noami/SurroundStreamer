{
  "name": "surround-streamer",
  "version": "0.1.0",
  "description": "macOS Ogg Opus surround audio streamer for Icecast",
  "main": "./out/main/index.js",
  "author": {
    "name": "Non-REM Studio (t-noami)",
    "email": "info@non-rem.com",
    "url": "https://github.com/t-noami"
  },
  "homepage": "https://github.com/t-noami/SurroundStreamer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/t-noami/SurroundStreamer.git"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build:audio-helper && npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build:audio-helper && npm run build && electron-builder --mac",
    "build:mac:dir": "npm run build:audio-helper && npm run build && electron-builder --dir --config electron-builder.yml",
    "build:beta:mac": "npm run build:audio-helper && npm run build && electron-builder --dir --config electron-builder.beta.yml",
    "build:beta:win": "npm run build && electron-builder --win --config electron-builder.beta.yml",
    "build:beta:linux": "npm run build && electron-builder --linux --config electron-builder.beta.yml",
    "build:linux": "npm run build && electron-builder --linux",
    "build:audio-helper": "bash scripts/build-audio-tap-helper.sh",
    "build:audio-helper:win": "powershell -ExecutionPolicy Bypass -File scripts/build-windows-audio-helper.ps1"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config": "^2.1.0",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "prettier": "^3.7.4",
    "vite": "^7.2.6"
  }
}
